# Database (Postgres) — e.g. from Neon, Supabase, or Railway
DATABASE_URL="postgresql://user:password@localhost:5432/citizen_project"

# NextAuth (Phase 2 — auth not yet wired in this build)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Paystack (covers MTN/Telecel/AirtelTigo Mobile Money + Visa/Mastercard in Ghana)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Cloudinary (media uploads: survey photos/videos, gallery images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (contact form / newsletter confirmations — e.g. Resend, SMTP)
EMAIL_FROM="hello@thecitizenproject.org"
RESEND_API_KEY=""
